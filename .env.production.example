# .env de produção (VPS, /srv/apps/tectune/.env, chmod 600).
# Crie com: sh deploy/provision-env.sh  (gera a senha do banco)

# banco de dados — troque a senha! (gere com: openssl rand -base64 32 | tr -d '/+=')
POSTGRES_DB=tectune
POSTGRES_USER=tectune
POSTGRES_PASSWORD=TROQUE-ESTA-SENHA

# fuso horário dos logs e da hora do backup
TZ=America/Fortaleza

# backups diários (pg_dump): pasta na VPS, quantos dias guardar e a hora
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=4

# sessão de login expira depois de N dias sem uso
SESSION_DAYS=90

# origens liberadas para a API (versão web do app mobile). "*" libera todas (a API usa token, não cookie)
CORS_ORIGINS=*
